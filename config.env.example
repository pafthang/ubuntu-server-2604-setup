# Скопируйте в config.env и заполните: cp config.env.example config.env
# Файл читают оба скрипта: 10-packages.sh и 20-hardening.sh.
#
# ВНИМАНИЕ: SSH-ключи и запрет парольного входа настраиваются ПРИ СОЗДАНИИ
# сервера (панель провайдера / cloud-init). Эти скрипты доступом не управляют.

# Порт, на котором будет слушать sshd после 20-hardening.sh
SSH_PORT=22

# Часовой пояс; пусто = не трогать
TIMEZONE="Europe/Moscow"

# Swap для мини-VPS с 1–2 ГБ RAM
CREATE_SWAP=false
SWAP_SIZE=2G