# Скопируйте в config.env и заполните: cp config.env.example config.env
# Файл читают все три скрипта.

# Порт, на котором будет слушать sshd после 30-hardening.sh
SSH_PORT=22

# Откуда брать публичные ключи (URL или путь к файлу).
# GitHub умеет отдавать свои ключи одним запросом: https://github.com/<user>.keys
KEY_URL=""

# Часовой пояс; пусто = не трогать
TIMEZONE="Europe/Moscow"

# Swap для мини-VPS с 1–2 ГБ RAM
CREATE_SWAP=false
SWAP_SIZE=2G